MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=spese_tracker

APP_USERNAME=admin
# Generate with: npm run hash-password -- "your-password"
# Paste the escaped APP_PASSWORD_HASH line printed by the script.
APP_PASSWORD_HASH=
SESSION_SECRET=change-me-with-a-long-random-string

# In production APP_USERNAME, APP_PASSWORD_HASH, SESSION_SECRET and MONGODB_URI
# are required. Local development can omit APP_PASSWORD_HASH and MONGODB_URI.
